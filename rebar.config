{erl_opts, [debug_info]}.

{plugins, [{rebar3_ex_doc, "0.2.30"},
           {rebar3_dialyzer_html, "0.2.0"},
           {rebar3_hex, "7.1.0"}]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [{extras, ["README.md", "LICENSE"]},
          {main, "README.md"},
          {source_url, "https://github.com/haruki7049/epc"}]}.

{deps, []}.

{project_plugins, [rebar3_hex]}.
